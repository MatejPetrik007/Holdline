# Pinned upstream sources of the Holdline public firmware.
# Read by fetch-deps.sh and apply-overlay.sh. Change a pin only together with a full
# test run (host tests + CI build of every board) and a new signed release.

# meshtastic/firmware: the base the overlay applies to.
MESHTASTIC_REPO=https://github.com/meshtastic/firmware
MESHTASTIC_TAG=v2.8.2.4c89b69
